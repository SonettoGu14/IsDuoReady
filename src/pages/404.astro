---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../lib/url';
---

<BaseLayout lang="en" title="Page not found — IsDuoReady">
  <section class="page-hero shell not-found">
    <p class="not-found-code">404</p>
    <h1>This page does not exist. / 这个页面不存在。</h1>
    <p>
      <a class="text-link" href={localePath('en', '/')}>Browse the app index</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href={localePath('zh', '/')}>浏览应用索引</a>
    </p>
  </section>
</BaseLayout>
