---
import FoldMark from './FoldMark.astro';
import { t } from '../lib/i18n';
import { localePath, switchLocalePath } from '../lib/url';
import type { Locale } from '../lib/types';

interface Props {
  lang: Locale;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const homePath = localePath(lang, '/');
const methodPath = localePath(lang, '/method/');
const contributePath = localePath(lang, '/contribute/');
const isApps = currentPath === homePath || currentPath.includes('/app/');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={homePath} aria-label="IsDuoReady home">
      <FoldMark size={25} />
      <span>IsDuoReady</span>
    </a>
    <nav class="main-nav" aria-label="Primary">
      <a href={homePath} aria-current={isApps ? 'page' : undefined}>{t(lang, 'nav.apps')}</a>
      <a href={methodPath} aria-current={currentPath === methodPath ? 'page' : undefined}>{t(lang, 'nav.method')}</a>
      <a href={contributePath} aria-current={currentPath === contributePath ? 'page' : undefined}>{t(lang, 'nav.contribute')}</a>
    </nav>
    <div class="header-actions">
      <div class="language-switch" aria-label="Language">
        <a href={switchLocalePath(currentPath, 'en')} data-locale-switch aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href={switchLocalePath(currentPath, 'zh')} data-locale-switch aria-current={lang === 'zh' ? 'true' : undefined}>中文</a>
      </div>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        data-label-light={t(lang, 'nav.theme.light')}
        data-label-dark={t(lang, 'nav.theme.dark')}
        aria-label={t(lang, 'nav.theme')}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function syncThemeButton() {
    if (!themeButton) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    themeButton.setAttribute('aria-pressed', String(dark));
    themeButton.setAttribute(
      'aria-label',
      dark ? themeButton.dataset.labelLight! : themeButton.dataset.labelDark!,
    );
  }

  syncThemeButton();
  themeButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('duo-theme', next);
    syncThemeButton();
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-locale-switch]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const target = new URL(link.href, window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.assign(target.href);
    });
  });
</script>
