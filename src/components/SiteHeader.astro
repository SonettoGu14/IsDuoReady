---
import FoldMark from './FoldMark.astro';
import { t } from '../lib/i18n';
import { localePath, switchLocalePath } from '../lib/url';
import type { Locale } from '../lib/types';

interface Props {
  lang: Locale;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const homePath = localePath(lang, '/');
const methodPath = localePath(lang, '/method/');
const contributePath = localePath(lang, '/contribute/');
const isApps = currentPath === homePath || currentPath.includes('/app/');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={homePath} aria-label="IsDuoReady home">
      <FoldMark size={25} />
      <span>IsDuoReady</span>
    </a>
    <nav class="main-nav" aria-label="Primary">
      <a href={homePath} aria-current={isApps ? 'page' : undefined}>{t(lang, 'nav.apps')}</a>
      <a href={methodPath} aria-current={currentPath === methodPath ? 'page' : undefined}>{t(lang, 'nav.method')}</a>
      <a href={contributePath} aria-current={currentPath === contributePath ? 'page' : undefined}>{t(lang, 'nav.contribute')}</a>
    </nav>
    <div class="header-actions">
      <div class="language-switch" aria-label="Language">
        <a href={switchLocalePath(currentPath, 'en')} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href={switchLocalePath(currentPath, 'zh')} aria-current={lang === 'zh' ? 'true' : undefined}>中文</a>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(lang, 'nav.theme')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('duo-theme', next);
  });
</script>
