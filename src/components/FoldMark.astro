---
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  aria-hidden="true"
>
  <rect x="2.5" y="4" width="7.5" height="16" rx="2" />
  <rect x="14" y="4" width="7.5" height="16" rx="2" />
  <path d="M12 2v20" stroke="var(--accent)" />
  <path d="M10.5 8h3M10.5 16h3" stroke="var(--accent)" />
</svg>
